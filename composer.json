{
    "name": "serenity_technologies/socialite-tradovate",
    "description": "Tradovate Socialite Provider for Laravel Socialite.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Kwadwo Kyeremeh",
            "email": "kyerematics@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "laravel/socialite": "^5.0",
        "socialiteproviders/manager": "^4.0"
    },
    "require-dev": {
        "orchestra/testbench": "^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0"
    },
    "autoload": {
        "psr-4": {
            "SocialiteProviders\\Tradovate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialiteProviders\\Tradovate\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
